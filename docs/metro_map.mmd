graph LR

    subgraph inputs [Inputs]
        %% nodes
		samplesheet[ ]
		samples[ ]
        _input_branch[]
        
        %% edges
        samplesheet --> |main, qc| _input_branch
        samples --> |main, qc| _input_branch
        %% reference --> |qc| input_branch
    end

	
    subgraph extraction [Sequence extraction & annotation]
    	%% metro exit: bottom | qc
        
        %% nodes
        matchbox[Extract VH, VL\nmatchbox]
        errorcorr[Error correction]
        riot[Annotate sequences\nriot]
        counts[Create counts matrix]
        _extract_end_node
        after_counts[]
        matchbox_script[ ]
        
        matchbox_script --> |main| matchbox  
        
        %% edges
		matchbox -->|main| errorcorr
        errorcorr -->|main| riot
        riot -->|main| counts
        %% counts -->|main| after_counts
        
        matchbox -->|qc| _extract_end_node
        riot -->|qc| _extract_end_node
                
        counts -->|main| counts_csv
		riot -->|main| annotated_csv
    end
    

    subgraph alignment [Alignment]
        %% nodes
        minimap2[Align sequences\nminimap2]
        samtools[Alignment statistics\nsamtools]
        indexed_sam[ ]
        reference[ ]

		%% edges
        reference -->|qc| minimap2
        minimap2 -->|qc| samtools
        samtools -->|qc| indexed_sam
    end



    subgraph qc [QC reporting]
		%% metro entry: bottom | qc
        %% metro direction: RL
    	%% nodes
        qc_html[ ]
        qcreport[Create QC report]
        
        %% edges
        qcreport -->|qc| qc_html

    end


    subgraph outputs [Outputs]
    	%% nodes
		
        
        counts_csv[ ]
        annotated_csv[ ]
        
    end
       
        
%% Inter-section edges - inputs
_input_branch -->|main| matchbox
_input_branch -->|qc| minimap2


